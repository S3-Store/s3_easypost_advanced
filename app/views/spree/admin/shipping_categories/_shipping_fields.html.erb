
<div data-hook="shipping_type" class="field align-center">
  <%= f.label :shipping_type %><br>
  <%= f.select :shipping_type,
                 Spree::ShippingCategory.shipping_types.keys.map { |k| [t("spree.shipping_types.#{k}"), k] },
                 { include_blank: false },
                 class: 'custom-select ' %>
</div>
